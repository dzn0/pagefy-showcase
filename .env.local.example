# Copie para .env.local e preencha. Nunca commite o .env.local real.

# Google Cloud Console → APIs e Serviços → Credenciais → Criar credenciais →
# ID do cliente OAuth → tipo "Aplicativo da Web". Em "Origens JavaScript
# autorizadas" adicione http://localhost:3030 (e depois o domínio de produção).
# Não precisa de redirect URI: o login usa pop-up, não redirecionamento.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Endereço do backend (pagefy-app/backend), que faz a busca no Google Places
# (a chave do Google fica no .env do backend, não aqui).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mapa da busca de leads (Leaflet). Chave grátis dos mapas da CARTO, enviada
# por e-mail na hora em https://carto.com/basemaps/apikey (5 mi de blocos/mês,
# crédito CARTO + OpenStreetMap visível). Vai na URL de cada bloco, então é
# pública (NEXT_PUBLIC_). Sem ela, o mapa usa os blocos padrão do OpenStreetMap.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=
